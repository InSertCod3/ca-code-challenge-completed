# Copy to .env and adjust if needed. Defaults work for the challenge out of the box.

MYSQL_ROOT_PASSWORD=root
WORDPRESS_DB_NAME=wp
WORDPRESS_DB_USER=wp
WORDPRESS_DB_PASSWORD=wp
WORDPRESS_TABLE_PREFIX=wp_

# Seeded admin credentials (informational — re-run scripts/seed.sh to recreate)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=admin
WP_ADMIN_EMAIL=admin@example.com
WP_SITE_URL=http://localhost:8080
WP_SITE_TITLE="Brand Reviews Challenge"

# New Django services: rotate all defaults before deploying beyond localhost.
DJANGO_SECRET_KEY=replace-with-a-long-private-django-key
CONTENT_DB_PASSWORD=local-content-password
AUTH_DB_PASSWORD=local-auth-password
AUTH_INTROSPECT_KEY=replace-this-with-a-separate-random-32-character-service-key

# Required for the Next.js + Clerk integration. Set these for YOUR Clerk application.
# Find keys and issuer in https://dashboard.clerk.com (do not commit .env).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
# The exact origin used in the browser; no trailing slash. Comma-separated values allowed.
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
